# ============================================================
#  .gitignore — EliteFX
#  Lengo kuu: KAMWE tusipush data ghafi (~26GB) wala virtual env.
#  Code, config, tests, na muhtasari pekee ndio huenda git.
# ============================================================

# === DATA (KAMWE haiwekwi git — iko kwenye PC ya Japhet, ~26GB) ===
# Zuia KILA kitu ndani ya data/ (subfolders zote, hata mpya), ila .gitkeep za muundo.
data/**
!data/
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep

# === Virtual environments (KAMWE haziwekwi git) ===
.venv/
venv/
env/
ENV/
.python-version

# === Ripoti: FUATILIA muhtasari za markdown (.md) — ni nyepesi, ni rekodi ===
# Zuia outputs NZITO tu (data dumps, charts), si ripoti za .md.
reports/*.csv
reports/*.parquet
reports/*.png
reports/*.html
reports/*.duckdb

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# === DuckDB / cache ===
*.duckdb
*.duckdb.wal
.cache/

# === OS / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
