# === Data (KAMWE haiwekwi git — iko kwenye PC ya Japhet, 26GB) ===
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Ripoti zinazozalishwa kiotomatiki (tunaweka muhtasari tu, sio output zote)
reports/*
!reports/.gitkeep

# === Python ===
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.python-version

# === DuckDB / cache ===
*.duckdb
*.duckdb.wal
.cache/

# === OS / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
